# Copiez ce fichier vers .env puis changez les mots de passe.

POSTGRES_USER=africard
POSTGRES_PASSWORD=changez-ce-mot-de-passe
POSTGRES_DB=africard
DATABASE_URL=postgresql+psycopg://africard:changez-ce-mot-de-passe@127.0.0.1:5432/africard

SECRET_SESSION=changez-cette-chaine-longue-et-aleatoire
BASE_URL=http://127.0.0.1:8000

ADMIN_IDENTIFIANT=Africaiim
ADMIN_MOT_DE_PASSE=changez-moi-au-moins-10

EXEMPLE_MOT_DE_PASSE=changez-moi-aussi

CUISINIERE_IDENTIFIANT=cuisiniere
CUISINIERE_MOT_DE_PASSE=changez-moi-aussi

# Jeton que le site envoie dans l'en-tête X-Jeton pour enregistrer un matricule.
INSCRIPTION_JETON=changez-cette-chaine-longue-et-aleatoire

# Serveur qui envoie le mail de débit cantine. Laissez SMTP_HOST vide pour préparer le message sans l'envoyer.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=1
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Université AFRICAIIM <noreply@africaiim.edu.gn>

# Mot de passe de départ des comptes étudiants (prenom.nom@univ-africaiim.com),
# à remplacer par l'étudiant à la première connexion.
ETUDIANT_MOT_DE_PASSE=Africaiim2026
