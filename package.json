{
  "name": "africaiim-scolarite",
  "version": "1.0.0",
  "private": true,
  "description": "Suivi des paiements de scolarité AfricaIIM — montants en francs guinéens entiers",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test tests/*.test.js",
    "backup": "node scripts/backup.js",
    "transfert": "node --disable-warning=ExperimentalWarning scripts/transfer-sqlite.js",
    "docker:up": "docker compose up -d --build",
    "docker:logs": "docker compose logs -f scolarite"
  },
  "dependencies": {
    "dotenv": "^18.0.6",
    "express": "^5.1.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.8"
  }
}
