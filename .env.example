PORT=4317
# Adresse imprimée dans le QR code du reçu. En production : https://scolarite.votredomaine.gn
PUBLIC_BASE_URL=http://localhost:4317
# true affiche les comptes de démonstration et un bouton pour le code à 6 chiffres.
# Mettre false avant toute ouverture sur Internet.
DEMO_MODE=true
# Jeton pour que le système de cartes lise le statut (laisser vide pour désactiver).
INTEGRATION_TOKEN=
# Mot de passe initial du super admin, utilisé seulement à la création du compte.
# Laisser vide pour en générer un, affiché une fois dans la console.
SUPER_ADMIN_INITIAL_PASSWORD=

# PostgreSQL (docker compose). Générer des mots de passe longs : openssl rand -hex 24
POSTGRES_USER=africaiim_admin
POSTGRES_PASSWORD=
SCOLARITE_DB_PASSWORD=
POSTGRES_PORT=5434
# Pour les scripts lancés hors Docker (transfert, tests). Remplacer MOT_DE_PASSE par SCOLARITE_DB_PASSWORD.
DATABASE_URL=postgres://scolarite:MOT_DE_PASSE@127.0.0.1:5434/africaiim
TEST_DATABASE_URL=postgres://scolarite:MOT_DE_PASSE@127.0.0.1:5434/africaiim_test
# Adresse de l'app Cartes vue depuis le conteneur.
CARD_API_URL_DOCKER=http://host.docker.internal:8000
# Sauvegardes automatiques : intervalle en secondes et durée de conservation en jours.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=30
