{
  "name": "africaiim-scolarite",
  "version": "1.1.0",
  "private": true,
  "description": "Suivi des paiements de scolarité AfricaIIM — montants en francs guinéens entiers",
  "type": "module",
  "main": "app.cjs",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "start": "node app.cjs",
    "build": "node scripts/build.js",
    "test": "node --test tests/*.test.js",
    "migrate": "node scripts/migrate.js",
    "backup": "node scripts/backup.js",
    "export": "node scripts/export.js",
    "import": "node scripts/import.js",
    "transfert": "node --disable-warning=ExperimentalWarning scripts/transfer-sqlite.js",
    "docker:up": "docker compose up -d --build",
    "docker:logs": "docker compose logs -f scolarite"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "dotenv": "^18.0.6",
    "express": "^5.1.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.8"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
