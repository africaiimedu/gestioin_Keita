PORT=4317
# development sur le poste, production en ligne.
NODE_ENV=development
# Adresse imprimée dans le QR code du reçu. En production : https://scolarite.votredomaine.com
PUBLIC_BASE_URL=http://localhost:4317
# true affiche les comptes de démonstration et un bouton pour le code à 6 chiffres.
# Toujours false en ligne.
DEMO_MODE=true
# Jeton pour que le système de cartes lise le statut (laisser vide pour désactiver).
INTEGRATION_TOKEN=
# Mot de passe initial du super admin, utilisé seulement à la création du compte.
# Laisser vide pour en générer un, affiché une fois dans la console.
SUPER_ADMIN_INITIAL_PASSWORD=
# Adresse de l'app Cartes (FastAPI). Vide = portail cartes désactivé.
CARD_API_URL=http://127.0.0.1:8000
CARD_API_TOKEN=

# --- Base PostgreSQL (lue par Sequelize) ---
# Poste local : base Docker. o2switch : base créée dans cPanel, par exemple
# postgres://cpaneluser_scolarite:MOT_DE_PASSE@localhost:5432/cpaneluser_africaiim
DATABASE_URL=postgres://scolarite:MOT_DE_PASSE@127.0.0.1:5434/africaiim
# Schéma qui contient les tables de la scolarité.
DB_SCHEMA=scolarite
DB_POOL_SIZE=10
# true seulement si le serveur PostgreSQL est distant et exige SSL.
DATABASE_SSL=false
# Base réservée aux tests (son nom doit finir par _test).
TEST_DATABASE_URL=postgres://scolarite:MOT_DE_PASSE@127.0.0.1:5434/africaiim_test

# --- En ligne derrière HTTPS (o2switch) ---
# true : l'adresse IP et le HTTPS transmis par le proxy de l'hébergeur sont pris en compte
# (cookies « Secure », HSTS, journal des connexions). Laisser vide sur le poste.
TRUST_PROXY=
# Dossier des pièces jointes (par défaut data/uploads).
UPLOAD_DIR=

# --- Docker (poste local uniquement). Générer des mots de passe longs : openssl rand -hex 24 ---
POSTGRES_USER=africaiim_admin
POSTGRES_PASSWORD=
SCOLARITE_DB_PASSWORD=
POSTGRES_PORT=5434
CARD_API_URL_DOCKER=http://host.docker.internal:8000
BACKUP_INTERVAL_SECONDS=86400

# --- Sauvegardes (npm run backup) ---
# docker ou direct ; vide = direct si pg_dump est installé, sinon docker.
BACKUP_MODE=
BACKUP_KEEP_DAYS=30
